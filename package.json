{
  "name": "480-academy-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de autenticación y cursos para 480 Academy",
  "scripts": {
    "dev": "npm run build:web && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "build:web": "tsc -p tsconfig.web.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
